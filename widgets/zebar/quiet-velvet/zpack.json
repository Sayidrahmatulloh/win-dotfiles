{
  "$schema": "https://github.com/glzr-io/zebar/raw/v3.1.1/resources/zpack-schema.json",
  "name": "quiet-velvet",
  "version": "1.0.1",
  "widgets": [
    {
      "htmlPath": "./dist/index.html",
      "zOrder": "normal",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "presets": [
        {
          "name": "default",
          "anchor": "top_center",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "100%",
          "height": "50px",
          "monitorSelection": {
            "type": "primary"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": null,
            "windowMargin": "0px"
          }
        },
        {
          "name": "default2",
          "anchor": "top_center",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "100%",
          "height": "50px",
          "monitorSelection": {
            "type": "primary"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": "top",
            "windowMargin": "0px"
          }
        }
      ],
      "name": "top-bar",
      "includeFiles": [
        "dist/**"
      ],
      "privileges": {
        "shellCommands": [
          {
            "program": "taskmgr",
            "argsRegex": "^$"
          },
          {
            "program": "explorer.exe",
            "argsRegex": "^https://www\\.google\\.com/search\\?q=[^\\s]*$"
          }
        ]
      },
      "caching": {
        "rules": [],
        "defaultDuration": 604800
      }
    }
  ]
}
