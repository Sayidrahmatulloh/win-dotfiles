# ── OS & System ────────────────────────────────────────────────
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ── Secrets & Credentials ──────────────────────────────────────
*.env
*.env.*
secrets.*
auth.json
*.pem
*.key

# ── Node.js / JavaScript ──────────────────────────────────────
node_modules/
dist/
build/
.npm/
.turbo/
.cache/

# Unused package manager lockfiles (Bun is preferred)
package-lock.json
pnpm-lock.yaml

# ── Fonts & Heavy Binaries ─────────────────────────────────────
# Heavy TTF fonts in web widgets (system fonts used instead)
**/CaskaydiaMonoNerdFont-Regular.ttf

# Proprietary / commercial fonts (prevent license/DMCA issues)
assets/fonts/monolisa.zip
assets/fonts/dankmono.zip
assets/fonts/dankmono-nf.zip

# ── Editor & IDEs ──────────────────────────────────────────────
.vscode/
.idea/
.zed/
*.swp
*.swo
*~
# Keep Neovim plugin revisions reproducible across machines.

# ── Backups & Temporary ────────────────────────────────────────
*.bak*
*.backup*
*.tmp
*.log

# Local Terminal export backups
config/terminal/*.bak_*

# Graphify generated output
graphify-out/
.test-tmp/
.dist-stage-*/
.dist-backup-*/
