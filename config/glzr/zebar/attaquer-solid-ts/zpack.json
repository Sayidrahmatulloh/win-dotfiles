{
  "$schema": "https://github.com/glzr-io/zebar/raw/v3.1.0/resources/zpack-schema.json",
  "name": "attaquer-solid-ts",
  "version": "1.0.1",
  "description": "Local Solid bar with guarded providers and keyboard controls.",
  "tags": [],
  "previewImages": [
    "Preview1.png"
  ],
  "repositoryUrl": "https://github.com/iAttaquer/.glzr",
  "widgets": [
    {
      "name": "top-bar",
      "htmlPath": "./dist/index.html",
      "zOrder": "top_most",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "includeFiles": [
        "dist/**"
      ],
      "caching": {
        "defaultDuration": 604800,
        "rules": []
      },
      "privileges": {
        "shellCommands": [
          {
            "program": "taskmgr",
            "argsRegex": "^$"
          },
          {
            "program": "explorer.exe",
            "argsRegex": "^ms-actioncenter://$"
          },
          {
            "program": "powershell.exe",
            "argsRegex": "^-NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -File [A-Za-z]:[/\\\\][^\"\\r\\n]*[/\\\\]attaquer-solid-ts[/\\\\]dist[/\\\\]assets[/\\\\]scripts[/\\\\]SetGlazeTheme\\.ps1 -Theme (green|blue|purple)$"
          }
        ]
      },
      "presets": [
        {
          "name": "1080p",
          "anchor": "top_center",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "100%",
          "height": "40px",
          "monitorSelection": {
            "type": "all"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": "top",
            "windowMargin": "50px"
          }
        },
        {
          "name": "1440p",
          "anchor": "top_left",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "100%",
          "height": "40px",
          "monitorSelection": {
            "type": "all"
          },
          "dockToEdge": {
            "enabled": true,
            "edge": "top",
            "windowMargin": "50px"
          }
        },
        {
          "name": "default3",
          "anchor": "top_left",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "100%",
          "height": "40px",
          "monitorSelection": {
            "type": "primary"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": "top",
            "windowMargin": "10px"
          }
        }
      ]
    }
  ]
}
